  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "\r",
          "const url = pm.request.url.toString();\r",
          "\r",
          "const expectedStatus = url.includes(\"minPrice=7000\")\r",
          "    ? 400\r",
          "    : 200;\r",
          "\r",
          "pm.test(\"Correct HTTP status code\", function () {\r",
          "    pm.response.to.have.status(expectedStatus);\r",
          "});\r",
          "\r",
          "pm.test(\"Response is valid JSON\", function () {\r",
          "    pm.response.to.be.json;\r",
          "});\r",
          "\r",
          "pm.test(\"Response time is under 5 seconds\", function () {\r",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
          "});\r",
          ""
        ],
        "type": "text/javascript"
      }
